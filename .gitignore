# nopekit:begin
# Written by nopekit: bytecode from importing model/, gates/ and selftest/,
# the readiness report `nopekit report --write` renders, and the packages
# `nopekit export` writes. Outputs, never sources.
__pycache__/
*.py[cod]
/REPORT.md
/out/
# nopekit:end

# Regenerated by build() on every `nopekit check`. The print files in
# build/print/ and the optimiser's cached field in build/topopt/ stay tracked:
# the first so the frame can be printed without installing anything, the second
# because re-deriving it takes ~6 minutes.
/build/assembly/
/build/preview.png
/build/topopt/run.log
