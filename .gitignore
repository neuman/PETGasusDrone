# nopekit:begin
# Written by nopekit: bytecode from importing model/, gates/ and selftest/,
# the readiness report `nopekit report --write` renders, the packages
# `nopekit export` writes, and the editor launch entry `nopekit init` writes
# with this machine's paths. Outputs, never sources.
__pycache__/
*.py[cod]
/REPORT.md
/out/
/.vscode/launch.json
# nopekit:end

# Regenerated by build() on every `nopekit check`. The print files in
# build/print/ stay tracked, so the frame can be printed without installing
# anything. The topology field the frame is drawn from is an input
# (inputs/data/), not an output, so it is tracked there.
/build/assembly/
/build/preview.png
/build/topopt3d/
/build/frame_cache/
/build/fea/
